# Copy to .env and fill in. Never commit the real .env.

# --- required ---------------------------------------------------------------
# MongoDB connection string (Atlas or local).
MONGO_URI=mongodb://127.0.0.1:27017/chatify

# Signing key for the auth cookie. Use a long random string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# --- optional ---------------------------------------------------------------
PORT=5001
NODE_ENV=development

# Where the browser app runs. Only needed in development, when the Vite dev
# server is on a different origin than the API. Comma-separate several.
CLIENT_URL=http://localhost:5173

# Images (profile pictures, group photos, photo messages) go to a private S3
# bucket and are served through /api/media. Leave S3_BUCKET blank in
# development and images are kept in memory (lost on restart). Required in
# production. The IAM user only needs s3:PutObject, s3:GetObject and s3:DeleteObject on it.
S3_BUCKET=
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
