# Copy to .env and fill in. Never commit the real .env.

# --- required ---------------------------------------------------------------
# MongoDB connection string (Atlas or local).
MONGO_URI=mongodb://127.0.0.1:27017/chatify

# Signing key for the auth cookie. Use a long random string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# --- optional ---------------------------------------------------------------
PORT=5001
NODE_ENV=development

# Where the browser app runs. Only needed in development, when the Vite dev
# server is on a different origin than the API. Comma-separate several.
CLIENT_URL=http://localhost:5173

# Cloudinary — only needed for profile pictures and image messages.
# Leave blank and the app runs fine with those two features disabled.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
